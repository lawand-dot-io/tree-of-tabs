{
  "manifest_version": 3,
  "name": "Tab Tree",
  "version": "1.0.0",
  "description": "See your tabs as a tree in the side panel. Tabs you open from a page nest under it, and you can drag them to reorganize.",
  "minimum_chrome_version": "116",
  "permissions": ["tabs", "webNavigation", "tabGroups", "sidePanel", "storage", "favicon"],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "src/sidepanel/sidepanel.html"
  },
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "Show tab tree",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+T"
      },
      "description": "Show or hide the tab tree"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
